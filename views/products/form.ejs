<%- include('../partials/head', { title: title }) %>

<h1 class="mb-4"><%= title %></h1>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<%# action เปลี่ยนตามงานเพิ่มหรือแก้ไข โดยใช้หน้า EJS เดียวกัน %>
<form action="<%= action %>" method="POST">
  <div class="mb-3">
    <label for="name" class="form-label">ชื่อสินค้า</label>
    <input
      id="name"
      name="name"
      type="text"
      class="form-control"
      value="<%= product.name %>"
      required
    >
  </div>

  <div class="mb-3">
    <label for="price" class="form-label">ราคา</label>
    <input
      id="price"
      name="price"
      type="number"
      min="0"
      step="0.01"
      class="form-control"
      value="<%= product.price %>"
      required
    >
  </div>

  <button class="btn btn-primary" type="submit">บันทึก</button>
  <a class="btn btn-secondary" href="/products">กลับ</a>
</form>

</body>
</html>